{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/game/**",
              "components/home/**",
              "components/lobby/**",
              "components/stats/**",
              "ui_kits/game-room/**",
              "ui_kits/r4box-apps/**",
              "ui_kits/r4box-home/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Unbounded|Sora))/i]",
        "message": "Font not provided by the design system. Available: Unbounded, Sora."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|emoji|size|online|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, emoji, size, online, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|how|got|progress|count|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: icon, title, how, got, progress, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bifurcation'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|animate|r0|r1|style|key|ref|className|style|children)$/]",
        "message": "<Bifurcation> doesn't accept that prop. Declared props: height, animate, r0, r1, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Board'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|cells|onCell|labels|style|key|ref|className|style|children)$/]",
        "message": "<Board> doesn't accept that prop. Declared props: size, cells, onCell, labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BoardCell> doesn't accept that prop. Declared props: state, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCell'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:water|ship|miss|hit|sunk|aim|peek)$/]",
        "message": "<BoardCell> state must be one of 'water' | 'ship' | 'miss' | 'hit' | 'sunk' | 'aim' | 'peek'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BotStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<BotStep> doesn't accept that prop. Declared props: value, max, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|display|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, display, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|fire|danger|link)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'fire' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: selected, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|tone|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: pressed, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|gold)$/]",
        "message": "<Chip> tone must be one of 'teal' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnterButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:alt|size|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<EnterButton> doesn't accept that prop. Declared props: alt, size, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EnterButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<EnterButton> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|password)$/]",
        "message": "<Field> type must be one of 'text' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GameCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|icon|name|blurb|who|checked|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GameCard> doesn't accept that prop. Declared props: kind, icon, name, blurb, who, checked, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GameCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:battleship|golf|duel|cards|war)$/]",
        "message": "<GameCard> kind must be one of 'battleship' | 'golf' | 'duel' | 'cards' | 'war'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GamePreview'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|ratio|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<GamePreview> doesn't accept that prop. Declared props: kind, ratio, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GamePreview'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:battleship|golf|duel|cards|war|gauntlet)$/]",
        "message": "<GamePreview> kind must be one of 'battleship' | 'golf' | 'duel' | 'cards' | 'war' | 'gauntlet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GameRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|vs|sub|pill|progress|mine|over|href|style|onClick|key|ref|className|style|children)$/]",
        "message": "<GameRow> doesn't accept that prop. Declared props: kind, title, vs, sub, pill, progress, mine, over, href, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='GameRow'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:battleship|golf|duel|cards|war|gauntlet)$/]",
        "message": "<GameRow> kind must be one of 'battleship' | 'golf' | 'duel' | 'cards' | 'war' | 'gauntlet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GamesDoor'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|desc|go|games|href|style|key|ref|className|style|children)$/]",
        "message": "<GamesDoor> doesn't accept that prop. Declared props: title, desc, go, games, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HubTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|desc|host|color|href|style|onClick|key|ref|className|style|children)$/]",
        "message": "<HubTile> doesn't accept that prop. Declared props: glyph, title, desc, host, color, href, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:off|children|style|key|ref|className|style|children)$/]",
        "message": "<LiveDot> doesn't accept that prop. Declared props: off, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:turn|wait|done|out|chaos|streak)$/]",
        "message": "<Pill> tone must be one of 'turn' | 'wait' | 'done' | 'out' | 'chaos' | 'streak'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|sub|href|style|onClick|key|ref|className|style|children)$/]",
        "message": "<QuickEntry> doesn't accept that prop. Declared props: icon, title, sub, href, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='R4Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|sub|spin|href|style|key|ref|className|style|children)$/]",
        "message": "<R4Mark> doesn't accept that prop. Declared props: size, sub, spin, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|animate|children|style|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: tone, animate, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|red|blue|purple)$/]",
        "message": "<Stamp> tone must be one of 'gold' | 'red' | 'blue' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|me|stats|kinds|streak|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: name, me, stats, kinds, streak, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Status'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Status> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Status'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|bad|good)$/]",
        "message": "<Status> tone must be one of 'info' | 'bad' | 'good'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UpCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|vs|sub|clock|cta|href|style|onClick|key|ref|className|style|children)$/]",
        "message": "<UpCard> doesn't accept that prop. Declared props: kind, title, vs, sub, clock, cta, href, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='UpCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:battleship|golf|duel|cards|war)$/]",
        "message": "<UpCard> kind must be one of 'battleship' | 'golf' | 'duel' | 'cards' | 'war'."
      }
    ]
  },
